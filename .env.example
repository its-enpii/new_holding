APP_NAME="Holding"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis = pure-PHP Redis client, jadi container tidak butuh ext-redis.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# Redis pusat untuk token SSO lintas aplikasi.
# Server sama: arahkan semua aplikasi ke host+port redis holding (mis. 127.0.0.1:6380).
# Server berbeda: isi IP/DNS publik server holding + password yang sama.
SSO_REDIS_HOST=127.0.0.1
SSO_REDIS_PORT=6380
SSO_REDIS_PASSWORD=
SSO_REDIS_DB=0
SSO_CACHE_REDIS_CONNECTION=sso

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# ---------------------------------------------------------------------------
# Docker stack (docker-compose.yml) — see docs/SSO-CONTRACT.md for the SSO bus.
# Host artisan keeps using the sqlite DB above; the *_below* values are only
# consumed by compose interpolation, never by the sqlite connection.
# ---------------------------------------------------------------------------
APP_PORT=8092
APP_UID=1000
APP_GID=1000
HOLDING_DB_DATABASE=holding
HOLDING_DB_USERNAME=holding
HOLDING_DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
FORWARD_DB_PORT=3311
# Container-side coordinates (compose network). Intentionally separate from
# DB_HOST/REDIS_HOST above: the host CLI uses published loopback ports, the
# containers use service names. Override only to point containers at external
# servers.
# COMPOSE_DB_HOST=mysql
# COMPOSE_DB_PORT=3306
# COMPOSE_REDIS_HOST=redis
# COMPOSE_REDIS_PORT=6379
# COMPOSE_REDIS_PASSWORD=
# SSO bus inside this stack: the redis-sso service. Override with the holding
# server IP + 6380 when this stack runs elsewhere (mode 2, SSO-CONTRACT).
# SSO_COMPOSE_REDIS_HOST=redis-sso
# SSO_COMPOSE_REDIS_PORT=6379
SSO_REDIS_BIND_IP=0.0.0.0
FORWARD_SSO_REDIS_PORT=6380
